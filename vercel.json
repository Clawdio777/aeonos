{
  "rewrites": [
    {
      "source": "/.well-known/agent.json",
      "destination": "/public/.well-known/agent.json"
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "/public/.well-known/mcp/server-card.json"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/.well-known/agent.json"
    },
    {
      "source": "/api/agent-card",
      "destination": "/api/agent?agent-card=true"
    },
    {
      "source": "/SKILL.md",
      "destination": "/public/SKILL.md"
    },
    {
      "source": "/favicon.svg",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/aeonos-logo.jpg",
      "destination": "/public/aeonos-logo.jpg"
    },
    {
      "source": "/llms.txt",
      "destination": "/public/llms.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/agent.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/agent.ts": {
      "maxDuration": 300
    },
    "api/audit.ts": {
      "maxDuration": 300
    },
    "api/schema.ts": {
      "maxDuration": 300
    },
    "api/llms-txt.ts": {
      "maxDuration": 300
    },
    "api/progress.ts": {
      "maxDuration": 300
    },
    "api/mcp.ts": {
      "maxDuration": 300
    },
    "api/internal.ts": {
      "maxDuration": 300
    },
    "api/share-of-voice.ts": {
      "maxDuration": 300
    },
    "api/checkout.ts": {
      "maxDuration": 30
    },
    "api/stripe-webhook.ts": {
      "maxDuration": 30
    },
    "api/recover-key.ts": {
      "maxDuration": 30
    },
    "api/citations.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/daily-summary",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron-check-deps",
      "schedule": "0 23 * * 0"
    }
  ]
}
