# AEONOS (AEON.OS) — Environment Variables
# Copy to .env and fill in values

# Anthropic
ANTHROPIC_API_KEY=

# Supabase — NEW isolated project (not Pemba)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenAI — for embeddings (optional but recommended)
OPENAI_API_KEY=

# Payment — Base/USDC wallet address for receiving x402 payments
PAYMENT_ADDRESS=

# Agent public URL (set in Vercel env vars after deploy)
AGENT_BASE_URL=https://aeonos.vercel.app

# Coinbase CDP facilitator (x402 verify + settle). Required: paid routes return 500
# "payments not configured" without both (no fallback to the default x402.org facilitator).
CDP_API_KEY_NAME=your-cdp-api-key-name
CDP_API_KEY_PRIVATE_KEY=your-cdp-api-key-private-key

# Base Builder Code (ERC-8021) for onchain attribution on settlements. Optional: off when unset.
BUILDER_CODE=your-builder-code

# Alerts to Carly on failed paid runs, failed or pending settlements. Each channel is optional.
RESEND_API_KEY=re_your-resend-key
NOTIFY_EMAIL=you@example.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
