# AEONOS (AEON.OS) — Environment Variables
# Copy to .env and fill in values

# Anthropic
ANTHROPIC_API_KEY=

# Supabase — NEW isolated project (not Pemba)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenAI — for embeddings (optional but recommended)
OPENAI_API_KEY=

# Payment — Base/USDC wallet address for receiving x402 payments
PAYMENT_ADDRESS=

# Agent public URL (set in Vercel env vars after deploy)
AGENT_BASE_URL=https://aeonos.vercel.app
